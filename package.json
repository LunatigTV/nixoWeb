        "@types/better-sqlite3": "^7.6.13",
        "@types/fs-extra": "^11.0.4",
        "@types/node": "^26.6.5",
        "drizzle-kit": "^0.31.11",
        "svelte": "5.57.3",
        "svelte-check": "^4.0.0",
        "tailwindcss": "^4.3.3",
        "tslib": "^2.4.1",
        "tsx": "^4.23.15",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.0",
        "vite": "8.3.3"
    }
